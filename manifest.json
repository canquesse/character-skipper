{
  "manifest_version": 3,
  "name": "Character Skipper for YouTube",
  "version": "3.1.0",
  "description": "Automatically skip scenes of selected characters on YouTube videos.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["*://*.youtube.com/*"],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["libs/human.js", "storage.js", "faceManager.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": ["models/*", "detection-worker.js", "libs/human.js", "libs/ort/*", "sandbox.html", "sandbox.js"],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}
